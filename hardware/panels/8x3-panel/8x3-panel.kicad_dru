(version 1)

(rule "Board_0-JLC flex: track width"
	(constraint track_width (min 0.076mm)))
(rule "Board_0-JLC flex: copper clearance"
	(constraint clearance (min 0.076mm)))

# --- Exposed pad to trace >= 0.15 mm; via ring to trace >= 0.1 mm
(rule "Board_0-JLC flex: pad to track"
	(condition "A.Type == 'Pad' && B.Type == 'Track'")
	(constraint clearance (min 0.15mm)))
(rule "Board_0-JLC flex: via to track"
	(condition "A.Type == 'Via' && B.Type == 'Track'")
	(constraint clearance (min 0.1mm)))

# --- Vias: regular 0.3 mm hole / 0.55 mm pad (extreme 0.10/0.30 costs extra)
(rule "Board_0-JLC flex: via size"
	(condition "A.Type == 'Via'")
	(constraint hole_size (min 0.3mm))
	(constraint via_diameter (min 0.55mm))
	(constraint annular_width (min 0.1mm)))

# --- Plated through-hole pads: annular ring >= 0.18 mm (0.25 recommended)
(rule "Board_0-JLC flex: PTH annular ring"
	(condition "A.Type == 'Pad' && A.Pad_Type == 'Through-hole'")
	(constraint annular_width (min 0.18mm)))

# --- Holes: 0.1-6.5 mm; plated slots >= 0.5 mm
(rule "Board_0-JLC flex: hole size"
	(constraint hole_size (min 0.1mm) (max 6.5mm)))
(rule "Board_0-JLC flex: plated slot"
	(condition "A.isPlated() && A.Hole_Size_X != A.Hole_Size_Y")
	(constraint hole_size (min 0.5mm)))

# --- NPTH / slots to copper >= 0.2 mm
(rule "Board_0-JLC flex: NPTH to copper"
	(condition "A.Type == 'Pad' && A.Pad_Type == 'NPTH, mechanical'")
	(constraint hole_clearance (min 0.2mm)))

# --- Laser outline: copper to board edge / slots >= 0.3 mm
(rule "Board_0-JLC flex: copper to edge"
	(constraint edge_clearance (min 0.3mm)))

# --- Silkscreen: height >= 1 mm, line >= 0.15 mm, to pads >= 0.15 mm
(rule "Board_0-JLC flex: silk text"
	(layer "?.Silkscreen")
	(constraint text_height (min 1mm))
	(constraint text_thickness (min 0.15mm)))
(rule "Board_0-JLC flex: silk to pad"
	(layer "?.Silkscreen")
	(constraint silk_clearance (min 0.15mm)))
(rule "Board_1-JLC flex: track width"
	(constraint track_width (min 0.076mm)))
(rule "Board_1-JLC flex: copper clearance"
	(constraint clearance (min 0.076mm)))

